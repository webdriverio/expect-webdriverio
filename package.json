{
  "name": "expect-webdriverio",
  "version": "7.0.0",
  "author": "Mykola Grybyk <mykola.grybyk@gmail.com>",
  "description": "WebdriverIO Assertion Library",
  "license": "MIT",
  "homepage": "https://webdriver.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdriverio/expect-webdriverio.git"
  },
  "bugs": {
    "url": "https://github.com/webdriverio/expect-webdriverio/issues"
  },
  "keywords": [
    "expect-webdriverio",
    "expect",
    "webdriverio",
    "wdio"
  ],
  "type": "module",
  "module": "./lib/index.js",
  "exports": {
    ".": [
      {
        "types": "./types/expect-webdriverio.d.ts",
        "import": "./lib/index.js"
      },
      "./lib/index.js"
    ],
    "./jest": [
      {
        "types": "./jest.d.ts"
      }
    ],
    "./jasmine": [
      {
        "types": "./jasmine.d.ts"
      }
    ],
    "./jasmine-wdio-expect-async": [
      {
        "types": "./jasmine-wdio-expect-async.d.ts"
      }
    ],
    "./expect-global": "./types/expect-global.d.ts",
    "./api": [
      {
        "types": "./types/expect-webdriverio.d.ts",
        "import": "./lib/api/index.js"
      },
      "./lib/api/index.js"
    ]
  },
  "types": "./types/expect-webdriverio.d.ts",
  "typeScriptVersion": "3.8.3",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c",
  "scripts": {
    "build": "run-s clean compile",
    "clean": "run-p clean:*",
    "clean:build": "rimraf ./lib",
    "compile": "run-s compile:*",
    "compile:lib": "tsc --build tsconfig.build.json",
    "compile:check": "if [ ! -f lib/index.js ] || [ $(find lib -type f | wc -l) -le 30 ]; then echo 'File structure under lib is broken'; exit 1; fi",
    "tsc:root-types": "node types-checks-filter-out-node_modules.js",
    "test": "run-s test:*",
    "test:tsc": "tsc --project tsconfig.json --noEmit --rootDir .",
    "test:lint": "oxlint",
    "test:unit": "vitest --run",
    "test:types": "pnpm run ts && pnpm run tsc:root-types",
    "ts": "run-s ts:* ts:*:*",
    "ts:jasmine": "cd test-types/jasmine && vitest --typecheck --typecheck.tsconfig ./tsconfig.json --run",
    "ts:jasmine-global-expect-async": "cd test-types/jasmine-global-expect-async && vitest --typecheck --typecheck.tsconfig ./tsconfig.json --run",
    "ts:jest:@types-jest": "cd test-types/jest-@types_jest && vitest --typecheck --typecheck.tsconfig ./tsconfig.json --run",
    "ts:mocha": "cd test-types/mocha && vitest --typecheck --typecheck.tsconfig ./tsconfig.json --run",
    "ts:arethetypeswrong": "attw --pack . --profile esm-only",
    "checks:all": "pnpm run build && pnpm test",
    "watch": "pnpm run compile --watch",
    "prepare": "husky",
    "playgrounds:clean": "rimraf --glob '**/node_modules'",
    "playgrounds:setup": "pnpm run playgrounds:clean; pnpm install && cd playgrounds && pnpm run setup",
    "playgrounds:checks:all": "cd playgrounds && pnpm run checks:all",
    "playgrounds:snapshots:update": "cd playgrounds && pnpm run snapshots:update"
  },
  "dependencies": {
    "@vitest/snapshot": "^5.0.2",
    "deep-eql": "^5.0.2",
    "expect": "^30.5.2",
    "jest-matcher-utils": "^30.5.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jest/globals": "^30.5.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/debug": "^4.1.13",
    "@types/deep-eql": "^4.0.2",
    "@types/jasmine": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/protocols": "^9.31.5",
    "@wdio/types": "^9.32.0",
    "husky": "^9.1.7",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.85.0",
    "release-it": "^21.1.0",
    "rimraf": "^6.1.3",
    "strip-ansi": "^7.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "webdriver": "^9.32.0",
    "webdriverio": "^9.32.0"
  },
  "peerDependencies": {
    "webdriverio": "^9.31.5"
  },
  "peerDependenciesMeta": {
    "webdriverio": {
      "optional": false
    }
  }
}
