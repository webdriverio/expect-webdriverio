{
  "name": "expect-wdio-playground-mocha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playground project for testing expect-webdriverio",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "wdio run wdio.conf.ts",
    "lint": "eslint .",
    "checks:all": "pnpm run typecheck && pnpm run lint && pnpm test",
    "snapshots:update": "pnpm run test --spec snapshot.test.ts --updateSnapshots && pnpm run test --spec visual-snapshot.test.ts --update-visual-baseline"
  },
  "devDependencies": {
    "@wdio/mocha-framework": "^9.32.0",
    "eslint-plugin-mocha": "^11.3.0"
  },
  "peerDependencies": {
    "@wdio/cli": "*",
    "@wdio/globals": "*",
    "@wdio/local-runner": "*",
    "@wdio/spec-reporter": "*",
    "@wdio/visual-service": "*"
  }
}
