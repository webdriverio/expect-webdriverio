{
  "name": "expect-wdio-playgrounds",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Playground projects common dependencies",
  "workspaces": ["./jasmine", "./jest", "./mocha", "./multi-remote-mocha", "./browser-runner"],
  "scripts": {
    "preinstall": "cd .. && npm run compile",
    "setup": "npm install",
    "typecheck": "npm exec --workspaces --call 'npm run typecheck'",
    "test": "npm exec --workspaces --call 'npm run test'",
    "lint": "npm exec --workspaces --call 'npm run lint'",
    "checks:all": "npm run typecheck && npm run lint && npm test",
    "snapshots:update": "npm exec --workspace=mocha --call 'npm run snapshots:update'"
  },
  "devDependencies": {
    "expect-webdriverio": "file:..",
    "@wdio/cli": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/visual-service": "^10.1.0",
    "eslint": "^9.39.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "eslint-plugin-wdio": {
      "expect-webdriverio": "$expect-webdriverio"
    },
    "@wdio/browser-runner": {
      "expect-webdriverio": "$expect-webdriverio"
    },
    "@wdio/globals": {
      "expect-webdriverio": "$expect-webdriverio"
    },
    "@wdio/wdio-jasmine-framework": {
      "expect-webdriverio": "$expect-webdriverio"
    },
    "@wdio/local-runner": {
      "expect-webdriverio": "$expect-webdriverio"
    },
    "@wdio/runner": {
      "expect-webdriverio": "$expect-webdriverio"
    },
    "@wdio/mocha-framework": {
      "expect-webdriverio": "$expect-webdriverio"
    },
    "expect": {
      "version": "^30.4.1"
    }
  }
}
