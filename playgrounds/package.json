{
  "name": "expect-wdio-playgrounds",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Playground projects common dependencies",
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c",
  "scripts": {
    "preinstall": "cd .. && pnpm run compile",
    "setup": "pnpm install",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "lint": "pnpm -r run lint",
    "checks:all": "pnpm run typecheck && pnpm run lint && pnpm test",
    "snapshots:update": "pnpm --filter ./mocha run snapshots:update"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@wdio/browser-runner": "^10.0.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/runner": "^10.0.2",
    "@wdio/spec-reporter": "^10.0.1",
    "@wdio/visual-service": "^10.2.1",
    "eslint": "^9.39.5",
    "expect-webdriverio": "link:..",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webdriver": "^10.0.2",
    "webdriverio": "^10.0.2"
  }
}
