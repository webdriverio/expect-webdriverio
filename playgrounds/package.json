{
  "name": "expect-wdio-playgrounds",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Playground projects common dependencies",
  "workspaces": ["./jasmine", "./jest", "./mocha", "./multi-remote-mocha"],
  "scripts": {
    "preinstall": "cd .. && npm run compile",
    "setup": "npm install",
    "typecheck": "npm exec --workspaces --call 'npm run typecheck'",
    "test": "npm exec --workspaces --call 'npm run test'",
    "lint": "npm exec --workspaces --call 'npm run lint'",
    "checks:all": "npm run typecheck && npm run lint && npm test",
    "snapshots:update": "npm exec --workspace=mocha --call 'npm run snapshots:update'"
  },
  "devDependencies": {
    "expect-webdriverio": "file:..",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/visual-service": "^10.1.0",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "expect": "30.4.1",
    "jest": "30.4.2",
    "jest-diff": "30.4.1",
    "jest-matcher-utils": "30.4.1",
    "expect-webdriverio": "$expect-webdriverio",
    "@wdio/cli": {
      "expect-webdriverio": "$expect-webdriverio",
      "@wdio/config": {
        "expect-webdriverio": "$expect-webdriverio"
      }
    },
    "@wdio/globals": {
      "expect-webdriverio": "$expect-webdriverio"
    },
    "@wdio/local-runner": {
      "expect-webdriverio": "$expect-webdriverio",
      "@wdio/runner": {
        "expect-webdriverio": "$expect-webdriverio",
        "@wdio/config": {
          "expect-webdriverio": "$expect-webdriverio"
        }
      }
    },
    "@wdio/runner": {
      "expect-webdriverio": "$expect-webdriverio",
      "@wdio/config": {
        "expect-webdriverio": "$expect-webdriverio"
      }
    },
    "@wdio/browser-runner": {
      "expect-webdriverio": "$expect-webdriverio",
      "@wdio/runner": {
        "expect-webdriverio": "$expect-webdriverio"
      }
    },
    "@wdio/mocha-framework": {
      "expect-webdriverio": "$expect-webdriverio"
    },
    "@wdio/jasmine-framework": {
      "expect-webdriverio": "$expect-webdriverio"
    },
    "eslint-plugin-wdio": {
      "expect-webdriverio": "$expect-webdriverio"
    }
  }
}
