    "expect-webdriverio": "link:../..",
    "strip-ansi": "^7.2.0"
  },
  "peerDependencies": {
    "@wdio/cli": "^10.0.1",
    "@wdio/globals": "^10.0.1",
    "@wdio/local-runner": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "@wdio/visual-service": "*"
  }
}
