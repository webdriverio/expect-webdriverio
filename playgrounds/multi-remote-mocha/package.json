{
  "name": "expect-wdio-playground-multi-remote-mocha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playground project for testing expect-webdriverio",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "wdio run wdio.conf.ts",
    "lint": "eslint .",
    "checks:all": "pnpm run typecheck && pnpm run lint && pnpm test"
  },
  "devDependencies": {
